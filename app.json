{
  "expo": {
    "name": "Cash",
    "slug": "cash",
    "scheme": "cash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cash.controlefinanceiro",
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8665B5"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#8665B5"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Cash usa suas fotos para ler dados de comprovantes que você escolher.",
          "cameraPermission": "O Cash usa a câmera para ler seus comprovantes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-ocr-kit",
        {
          "cameraPermission": "O Cash usa a câmera para ler seus comprovantes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "58c25c79-c55f-41de-b77c-055b09257718"
      }
    }
  }
}
